services:
  - type: web
    name: tapgame
    runtime: python
    plan: free
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /health
    envVars:
      - key: PYTHON_VERSION
        value: 3.11.9
      - key: BOT_TOKEN
        sync: false
      - key: SECRET_KEY
        sync: false
      - key: ADMIN_USER_ID
        sync: false
      - key: ADMIN_BOT_TOKEN
        sync: false
      - key: ALLOWED_ORIGINS
        value: "*"
